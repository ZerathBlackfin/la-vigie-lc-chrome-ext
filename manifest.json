{
  "manifest_version": 3,
  "name": "La Vigie (LC)",
  "version": "1.0.4",
  "description": "Recherche multi-trackers depuis les posts La Cale",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://nyaa.si/*",
    "https://yggapi.eu/*",
    "https://www.sharewood.tv/*",
    "https://la-cale.space/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
